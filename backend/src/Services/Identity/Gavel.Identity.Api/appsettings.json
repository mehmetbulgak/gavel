{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "gavel-identity",
    "Audience": "gavel"
  },
  "Jwt": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SessionLifetimeDays": 30
  },
  "LoginThrottling": {
    "MaxFailuresPerAccount": 10,
    "WindowMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
