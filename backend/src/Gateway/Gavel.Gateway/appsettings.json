{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "gavel-identity",
    "Audience": "gavel",
    "MetadataAddress": "http://identity/.well-known/openid-configuration",
    "RequireHttpsMetadata": true
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownNetworks": []
  },
  "RateLimits": {
    "SignIn": 10,
    "Session": 60,
    "Bids": 60,
    "Listings": 10,
    "Api": 300,
    "Realtime": 600,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "auth-sign-in": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "sign-in",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/{action:regex(^(login|register)$)}",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-session": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "session",
        "Order": 0,
        "Match": {
          "Path": "/api/auth/{action:regex(^(refresh|logout)$)}",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "api",
        "Order": 10,
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "auctions-bid": {
        "ClusterId": "auctions",
        "RateLimiterPolicy": "bids",
        "Order": 0,
        "Match": {
          "Path": "/api/auctions/{id:guid}/bids",
          "Methods": [
            "POST"
          ]
        }
      },
      "auctions-create": {
        "ClusterId": "auctions",
        "RateLimiterPolicy": "listings",
        "Order": 0,
        "Match": {
          "Path": "/api/auctions",
          "Methods": [
            "POST"
          ]
        }
      },
      "auctions": {
        "ClusterId": "auctions",
        "RateLimiterPolicy": "api",
        "Order": 10,
        "Match": {
          "Path": "/api/auctions/{**rest}"
        }
      },
      "my-activity": {
        "ClusterId": "auctions",
        "RateLimiterPolicy": "api",
        "Order": 10,
        "Match": {
          "Path": "/api/me/{**rest}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "RateLimiterPolicy": "api",
        "Order": 10,
        "Match": {
          "Path": "/api/notifications/{**rest}"
        }
      },
      "auctions-hub": {
        "ClusterId": "auctions",
        "RateLimiterPolicy": "realtime",
        "Order": 10,
        "Match": {
          "Path": "/hubs/auctions/{**rest}"
        }
      },
      "notifications-hub": {
        "ClusterId": "notifications",
        "RateLimiterPolicy": "realtime",
        "Order": 10,
        "Match": {
          "Path": "/hubs/notifications/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity"
          }
        }
      },
      "auctions": {
        "Destinations": {
          "primary": {
            "Address": "http://auctions"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "primary": {
            "Address": "http://notifications"
          }
        }
      }
    }
  }
}
